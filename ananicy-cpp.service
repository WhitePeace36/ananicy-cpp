[Unit]
Description=Ananicy-Cpp - ANother Auto NICe daemon in C++
After=local-fs.target

[Service]
Type=simple
ExecStartPre=/sbin/sysctl -e kernel.sched_autogroup_enabled=0
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/ananicy-cpp
ExecStopPost=/sbin/sysctl -e kernel.sched_autogroup_enabled=1
Nice=19
SuccessExitStatus=143
OOMScoreAdjust=-999
Restart=always
CPUAccounting=true
MemoryHigh=16M
MemoryMax=64M
ProtectSystem=true
ProtectHome=true
PrivateTmp=yes

[Install]
WantedBy=local-fs.target
